# Spring Boot 启动参数配置
# 用于设置 JVM 内存和栈大小

# 初始堆大小
-Xms512m

# 最大堆大小
-Xmx2g

# 线程栈大小（防止栈溢出）
-Xss2m

# 元空间大小
-XX:MetaspaceSize=128m
-XX:MaxMetaspaceSize=256m

# GC 配置
-XX:+UseG1GC
-XX:MaxGCPauseMillis=200
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=logs/heapdump.hprof

# 禁用偏向锁（某些场景下可提升性能）
-XX:-UseBiasedLocking

# 并行 GC 线程数
-XX:ParallelGCThreads=4

# 并发 GC 线程数
-XX:ConcGCThreads=1
